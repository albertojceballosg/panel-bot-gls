# Este fichero lo leen DOS cosas: Laravel (dentro del contenedor) y Docker Compose
# (en el host, para interpolar los ${...} de docker-compose.yml). Por eso las
# credenciales de Postgres viven aquí una sola vez y no en dos sitios.
#
# Copiá esto a `.env` y completá lo marcado como CAMBIAR. El `.env` NO se versiona.

APP_NAME="Panel Bot GLS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es

# --- Base de datos ----------------------------------------------------------
# DB_HOST=postgres es el nombre del servicio en la red de Compose; desde el host
# se llega por 127.0.0.1:${DB_PORT_HOST}.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=panel
DB_USERNAME=panel
DB_PASSWORD=CAMBIAR_password_local

# --- Endpoint que consume el bot -------------------------------------------
# Token que el bot manda como `Authorization: Bearer <token>` en GET /api/rutas.
# Debe coincidir con RUTAS_TOKEN del .env de bot-gls. Generá uno con:
#   openssl rand -hex 32
RUTAS_TOKEN=CAMBIAR_token_del_bot

# --- Usuario inicial del panel ----------------------------------------------
# Con el que entrás la primera vez. No hay registro público: las cuentas se
# crean con `php artisan db:seed --class=UsuarioInicialSeeder`, que es
# idempotente y sirve también para recuperar el acceso si se te olvida.
# La contraseña vive SÓLO aquí, nunca en el repo.
SEED_USER_NAME="Panel"
SEED_USER_EMAIL=CAMBIAR_tu@email
SEED_USER_PASSWORD=CAMBIAR_password_local

# --- Puertos publicados en el host -----------------------------------------
# Cambialos sólo si tenés algo ocupando esos puertos.
APP_PORT=8000
VITE_PORT=5173
DB_PORT_HOST=5432

# --- Dueño de los ficheros que escribe el contenedor ------------------------
# Debe ser tu UID/GID (`id -u`, `id -g`) o vendor/ y storage/ quedan como root.
UID=1000
GID=1000

# --- Resto de Laravel -------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Al desplegar (fase 5) --------------------------------------------------
# Los valores de arriba son los de desarrollo. En producción, además:
#
#   APP_ENV=production
#   APP_DEBUG=false            un error de PHP con el trazado entero delante es
#                              un mapa del panel para quien lo provoque
#   LOG_LEVEL=info
#   SESSION_SECURE_COOKIE=true la cookie de sesión sólo viaja por HTTPS; sin
#                              esto se manda también en claro, y esa cookie
#                              equivale a la contraseña mientras la sesión viva
#   SESSION_ENCRYPT=true       el payload de `sessions` va cifrado en la base
#
# Y las tres claves de §10 —RUTAS_TOKEN, DB_PASSWORD y SEED_USER_PASSWORD—
# distintas de las de desarrollo. Ninguna se escribe aquí, ni como ejemplo.
